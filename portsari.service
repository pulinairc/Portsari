[Unit]
Description=portsari, #pulina moderation lookout
After=network-online.target
Wants=network-online.target
# The channel logs live on an sshfs mount of the website; never run without them
RequiresMountsFor=/home/rolle/pulina.fi

[Service]
User=rolle
WorkingDirectory=/home/rolle/portsari
EnvironmentFile=/home/rolle/portsari/.env
ExecStart=/home/rolle/.pyenv/versions/sopel-8-env/bin/sopel start -c /home/rolle/portsari/portsari.cfg
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
